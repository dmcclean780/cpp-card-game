{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build SDL2 App",
      "type": "shell",
      "command": "clang++",
      "args": [
        "-std=c++17",
        "src/main.cpp",
        "src/ui/Button.cpp",
        "src/ui/TextBox.cpp",
        "src/utils/Fonts.cpp",
        "src/screens/LoadingScreen.cpp",
        "src/screens/StartingScreen.cpp",
        "src/screens/SettingsScreen.cpp",
        "src/screens/GameScreen.cpp",
        "src/game-components/Card.cpp",
        "src/game-components/Deck.cpp",
        "src/game-components/Player.cpp",
        "src/game-components/DiscardPile.cpp",
        "-o",
        "build/app",
        "-I${workspaceFolder}/include",
        "-I/opt/homebrew/include/SDL2", // ✅ Unified include path
        "-D_THREAD_SAFE",
        "-L/opt/homebrew/lib", // ✅ Unified lib path
        "-lSDL2",
        "-lSDL2_ttf",
        "-lSDL2_image",
        "-g"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}